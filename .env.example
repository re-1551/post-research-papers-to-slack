# Discord Bot Token
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID
# Discordで開発者モードを有効にし、チャンネルを右クリックして「IDをコピー」
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Google AI Studio API Key (Gemini)
# https://aistudio.google.com/app/apikey で取得
GOOGLE_API_KEY=your_google_ai_api_key_here

# Trigger Secret（GASからの呼び出しを認証するためのシークレット）
# ランダムな文字列を設定（例: openssl rand -hex 32）
TRIGGER_SECRET=your_random_secret_string_here

# 環境設定
NODE_ENV=development
TZ=Asia/Tokyo
PORT=10000
